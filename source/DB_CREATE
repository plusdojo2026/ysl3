CREATE DATABASE romance_magic;
USE romance_magic;

CREATE TABLE users (
    user_id INT PRIMARY KEY AUTO_INCREMENT NOT NULL,
    login_id VARCHAR(10) NOT NULL,
    user_name VARCHAR(10) NOT NULL,
    password VARCHAR(20) NOT NULL, CHECK (CHAR_LENGTH(password) >= 6),
    mail VARCHAR(255) NOT NULL,
    role INT NOT NULL DEFAULT '0', CHECK (role IN (0, 1)),
    sol INT NOT NULL DEFAULT '1', CHECK (sol IN (0, 1)),
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    update_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

CREATE TABLE projects (
    project_id INT PRIMARY KEY AUTO_INCREMENT NOT NULL,
    project_code VARCHAR(20) NOT NULL,
    project_name VARCHAR(100) NOT NULL,
    customer VARCHAR(50) NOT NULL,
    project_status INT NOT NULL DEFAULT '0', CHECK (project_status IN (0, 1, 2, 3)),
    project_priority INT NOT NULL DEFAULT '1', CHECK (project_priority IN (0, 1, 2)),
    pm_id INT NOT NULL,
    project_start_date DATE NOT NULL,
    project_end_date DATE,
    project_explanation VARCHAR(2000),
    project_limit DATE NOT NULL,
    project_estimated_works FLOAT NOT NULL,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    update_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

CREATE TABLE tasks (
    task_id INT PRIMARY KEY AUTO_INCREMENT NOT NULL,
    user_id INT NOT NULL,
    task_name VARCHAR(20) NOT NULL,
    task_status INT NOT NULL DEFAULT '0', CHECK (task_status IN (0, 1, 2, 3)),
    task_priority INT NOT NULL DEFAULT '1', CHECK (task_priority IN (0, 1, 2)),
    task_limit DATE NOT NULL,
    task_explanation VARCHAR(1000),
    task_estimated_works FLOAT NOT NULL,
    project_id INT NOT NULL,
    task_start_date DATE NOT NULL,
    task_end_date DATE,
    progress INT NOT NULL DEFAULT '0', CHECK (progress BETWEEN 0 AND 100 AND progress % 5 = 0),
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    update_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

CREATE TABLE works (
    work_id INT PRIMARY KEY AUTO_INCREMENT NOT NULL,
    task_id INT NOT NULL,
    work FLOAT NOT NULL, CHECK (work >= 0.5 AND work <= 24 AND work * 2 = FLOOR(work * 2)),
    work_explanation VARCHAR(1000),
    user_id INT NOT NULL,
    work_date DATE NOT NULL DEFAULT (CURRENT_DATE)
);

